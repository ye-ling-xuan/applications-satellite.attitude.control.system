{
  "version": "2.0.0",
  "tasks": [
    {"label": "Attitude: tests", "type": "process", "command": "${command:python.interpreterPath}", "args": ["-m", "pytest", "-q"], "options": {"cwd": "${workspaceFolder}"}, "group": {"kind": "test", "isDefault": true}, "problemMatcher": []},
    {"label": "Attitude: tune baselines", "type": "process", "command": "${command:python.interpreterPath}", "args": ["-m", "attitude_control.tune"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Attitude: evaluate baselines", "type": "process", "command": "${command:python.interpreterPath}", "args": ["-m", "attitude_control.evaluate", "--tuning", "artifacts/tuning_v1/tuning.json", "--plot"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Attitude: train independent PPO", "type": "process", "command": "${command:python.interpreterPath}", "args": ["-m", "attitude_control.train", "--profile", "precision_nominal", "--torque-penalty", "${input:torquePenalty}", "--mode", "pure", "--steps", "200000", "--seed", "${input:trainingSeed}", "--n-envs", "4", "--n-steps", "256", "--batch-size", "256", "--learning-rate", "0.0001", "--gamma", "0.98", "--ent-coef", "0.01", "--tuning", "artifacts/tuning_v1/tuning.json", "--output", "artifacts/precision_nominal_penalty${input:torquePenalty}_seed${input:trainingSeed}_${input:runTag}"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []}
  ],
  "inputs": [
    {"id": "trainingSeed", "type": "pickString", "description": "训练随机种子", "options": ["7", "19", "42", "61", "83"], "default": "7"},
    {"id": "torquePenalty", "type": "pickString", "description": "奖励中的力矩惩罚权重", "options": ["0.05", "0.5"], "default": "0.05"},
    {"id": "runTag", "type": "promptString", "description": "新输出目录标记，已有非空目录不会被覆盖", "default": "v2"}
  ]
}
