{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "externalTerminal"
        },
        {
            "name": "Debug attitude environment tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/test_env.py", "-q"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug held-out evaluation",
            "type": "debugpy",
            "request": "launch",
            "module": "attitude_control.evaluate",
            "args": ["--tuning", "artifacts/tuning_v1/tuning.json", "--output", "artifacts/debug_evaluation", "--plot"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
